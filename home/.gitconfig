[user]
	name = Chantel Diaz
	email = cdiaz@consumer-edge.com
	signingkey = 1C9539D93608875B
[commit]
	gpgsign = true
[push]
	default = current
	autoSetupRemote = true
[core]
	hooksPath = /Users/cdiaz/.config/git/hooks
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
